APP_NAME=Followme
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set to the canonical public HTTPS URL in production; password reset links use this host.
APP_URL=http://localhost

# Comma-separated proxy IPs or CIDRs; leave empty unless behind a trusted reverse proxy.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Attendance GPS geofence (office and production coordinates)
ATTENDANCE_GEOFENCE_RADIUS_METERS=100
ATTENDANCE_OFFICE_LATITUDE=-6.3357454
ATTENDANCE_OFFICE_LONGITUDE=106.9457406
ATTENDANCE_PRODUCTION_LATITUDE=-6.3357454
ATTENDANCE_PRODUCTION_LONGITUDE=106.9457406

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Use a Gmail address and its Google App Password; do not use your normal password.
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM_ADDRESS="dostoevsky@gmail.com"
MAIL_FROM_NAME="Sistem absensi Followme"

# Used by AdminUserSeeder only when creating the HRD login for the first time.
# Set a unique password of at least 12 characters in the server environment.
# HRD_ADMIN_EMAIL=hrd@anselmudaberkarya.com
# HRD_ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
